{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/handoff-session.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/handoff-stop.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
