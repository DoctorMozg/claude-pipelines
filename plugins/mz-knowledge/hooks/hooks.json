{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/frontmatter-normalize.sh",
            "if": "Write(//**/*.md)",
            "type": "command"
          }
        ],
        "matcher": "Write"
      },
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/frontmatter-normalize.sh",
            "if": "Edit(//**/*.md)",
            "type": "command"
          }
        ],
        "matcher": "Edit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/vault-context.sh",
            "type": "command"
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ]
  }
}
